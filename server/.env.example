# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# JWT Secrets – use a random 64-character hex string for each
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_HEX

# Token expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server
PORT=3001
NODE_ENV=development

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://tzhealthalliance.or.tz

# Database path (relative to server/ directory)
DB_PATH=./tha_admin.db
