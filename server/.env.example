# Copy to .env for local development. Never commit real secrets.

# Persistent PostgreSQL database (required on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Use two different random secrets
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_HEX
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# First administrator is provisioned automatically when the database is empty
ADMIN_IDENTIFIER=admin@tzhealthalliance.or.tz
ADMIN_PASSWORD=CHANGE_ME_MINIMUM_8_CHARACTERS
ADMIN_NAME=THA Administrator

# To reset an existing administrator, change ADMIN_PASSWORD privately and set
# this to a new unique value. Existing sessions are revoked after the reset.
ADMIN_PASSWORD_RESET_VERSION=

# Shared secret used only by the scheduled health-content importer.
# Set the same long random value in Vercel and GitHub Actions.
CONTENT_IMPORT_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_HEX

PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://tha-red.vercel.app,https://tzhealthalliance.or.tz,https://www.tzhealthalliance.or.tz
